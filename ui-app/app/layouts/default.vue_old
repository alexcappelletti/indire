<script setup lang="ts">
import { computed, nextTick, ref } from 'vue'
import { useRoute, useRouter } from 'vue-router'
type Message = { role: 'agent' | 'user'; text: string; time: string }
const activeNav = ref('Agente conversazionale')
const route = useRoute()
const router = useRouter()
const draft = ref('')
const showAllResources = ref(false)
const isTyping = ref(false)
const messages = ref<Message[]>([
	{ role: 'agent', text: 'Riprendiamo la situazione di Marco, 12 anni, seconda media. Negli ultimi due mesi noti che partecipa meno, ha alcune assenze e si mantiene pi? isolato rispetto al solito.\n\nQuali elementi osservabili ti fanno pensare a un possibile disagio, e quali invece potrebbero rientrare nella normale fase adolescenziale?', time: '10:24' },
	{ role: 'user', text: 'Ha ridotto le interazioni con il gruppo, ? spesso in disparte e ha avuto tre assenze nelle ultime settimane. Potrebbe essere solo pi? tranquillo, ma mi chiedo se ci sia qualcosa di pi?.', time: '10:27' },
	{ role: 'agent', text: 'E una riflessione attenta. Proviamo a distinguere tra ci? che osservi (i fatti) e le possibili interpretazioni. Quali altri segnali, magari nel rendimento, nel comportamento in classe o nel linguaggio, potresti considerare per orientarti meglio?', time: '10:28' }
])
const resources = [
	{ title: "Leggere i segnali: accorgersi in tempo dell'uso di sostanze tra scuola e famiglia", author: 'C. Caruso', relevance: 94 },
	{ title: 'Segnali precoci di dipendenza da sostanze: indicatori comportamentali, fisici e psicologici', author: 'C. Caruso', relevance: 87 },
	{ title: 'La scuola come presidio: il ruolo educativo nella prevenzione e nell’intervento precoce', author: 'C. Caruso', relevance: 79 },
	{ title: 'Presentazione - Adolescenza e vulnerabilit? ai comportamenti a rischio', author: 'C. Caruso', relevance: 68 }
]
const visibleResources = computed(() => showAllResources.value ? [...resources, ...resources.slice(0, 2)] : resources)
function sendMessage() {
	const text = draft.value.trim()
	if (!text || isTyping.value) return
	messages.value.push({ role: 'user', text, time: '10:31' }); draft.value = ''; isTyping.value = true
	nextTick(() => setTimeout(() => { messages.value.push({ role: 'agent', text: 'Grazie, hai aggiunto un elemento importante. Teniamo separate le osservazioni dalle ipotesi e chiediamoci quali informazioni possano aiutarci a verificarle, coinvolgendo anche la rete educativa.', time: '10:32' }); isTyping.value = false }, 900))
}
function goTo(path: string, label: string) { activeNav.value = label; router.push(path) }
</script>

<template>
	<div class="app-shell">
		<header class="topbar">
			<div class="brand">
				<div class="brain-mark">??</div>
				<div>
					<div class="brand-title">Piattaforma INDIRE - Prevenzione delle dipendenze e disagio giovanile</div>
					<div class="brand-subtitle">Assistenza metacognitiva per docenti</div>
				</div>
			</div>
			<nav class="main-nav" aria-label="Navigazione principale">
				<button :class="{ active: route.path === '/home' }" @click="goTo('/home', 'Home')"><span
						class="material-symbols-rounded nav-icon">home</span>Home</button>
				<button :class="{ active: route.path === '/' }" @click="goTo('/', 'Agente conversazionale')"><span
						class="material-symbols-rounded nav-icon">forum</span>Agente conversazionale</button>
				<button :class="{ active: route.path === '/percorso-e-learning' }"
					@click="goTo('/percorso-e-learning', 'Percorso e-learning')"><span
						class="material-symbols-rounded nav-icon">menu_book</span>Percorso e-learning</button>
				<button :class="{ active: route.path === '/risorse' }" @click="goTo('/risorse', 'Risorse')"><span
						class="material-symbols-rounded nav-icon">folder_open</span>Risorse</button><button
					class="profile" aria-label="Profilo"><span class="material-symbols-rounded">person</span></button>
			</nav>
		</header>
		<main class="page-content">
			<template v-if="route.path === '/'">
				<section class="upper-grid">
					<article class="chat-panel panel">
						<div class="chat-heading">
							<div class="heading-icon">?</div>
							<div class="heading-copy">
								<h1>Agente pedagogico-socratico <span class="info">i</span></h1>
								<p>Ti accompagno in un percorso di riflessione e di approfondimento, attraverso domande,
									esempi e rimandi<br class="desktop-only"> ai materiali della piattaforma, per
									rafforzare la tua lettura professionale del disagio giovanile e del contrasto alle
									dipendenze.</p>
							</div><button class="guide-button">? <span>Guida al dialogo</span></button>
						</div>
						<div class="conversation">
							<div v-for="(message, index) in messages" :key="index" class="message-row"
								:class="message.role">
								<div v-if="message.role === 'agent'" class="avatar agent-avatar">?</div>
								<div class="message-bubble"><span v-for="(line, lineIndex) in message.text.split('\n')"
										:key="lineIndex">{{ line }}<br
											v-if="lineIndex < message.text.split('\n').length - 1"></span><time>{{
												message.time }}</time></div>
								<div v-if="message.role === 'user'" class="avatar user-avatar">?</div>
							</div>
							<div v-if="isTyping" class="message-row agent">
								<div class="avatar agent-avatar">?</div>
								<div class="typing"><i></i><i></i><i></i></div>
							</div>
						</div>
						<form class="composer" @submit.prevent="sendMessage"><input v-model="draft"
								aria-label="Scrivi la tua risposta" placeholder="Scrivi la tua risposta..."><button
								type="submit" aria-label="Invia risposta">?</button></form>
					</article>
					<aside class="resources-panel panel">
						<div class="resource-header">
							<div class="folder-icon">?</div>
							<div>
								<h2>Risorse dalla piattaforma</h2>
								<p>Materiali consigliati dall'agente in relazione al tuo dialogo.<br>La rilevanza indica
									quanto il materiale ? pertinente<br> (calcolata dall'agente sulla base del tuo
									contributo).</p>
							</div>
						</div>
						<div class="resource-list">
							<div v-for="(resource, index) in visibleResources" :key="`${resource.title}-${index}`"
								class="resource-item">
								<div class="pdf-icon">PDF</div>
								<div class="resource-name"><strong>{{ resource.title }}</strong><span>{{ resource.author
								}}</span></div>
								<div class="relevance"><span>Rilevanza<br><b>{{ resource.relevance }}%</b></span>
									<div class="meter"><i :style="{ width: `${resource.relevance}%` }"
											:class="{ warning: resource.relevance < 75 }"></i></div>
								</div><span class="external">?</span>
							</div>
						</div><button class="all-resources" @click="showAllResources = !showAllResources">{{
							showAllResources ? 'Mostra meno' : 'Vedi tutte le risorse correlate (12)' }}
							<span></span></button>
					</aside>
				</section>
				<section class="journey panel">
					<div class="journey-title"><span class="journey-icon">?</span>
						<h2>Il tuo percorso metacognitivo</h2><span class="info">i</span>
					</div>
					<div class="journey-body">
						<div class="steps-block">
							<h3>Tappe del ragionamento professionale (Mappa) <span class="info">i</span></h3>
							<div class="steps">
								<div v-for="(step, index) in ['Osservare|i segnali', 'Organizzare|le informazioni', 'Formulare|ipotesi|educative', 'Confrontare|interpretazioni', 'Condividere|e coinvolgere', 'Orientare|alla rete', 'Pianificare|l’azione|educativa', 'Verificare']"
									:key="step" class="step" :class="{ done: index < 3, current: index === 3 }">
									<div class="step-dot">{{ index < 3 ? '?' : index + 1 }}</div><span
												v-for="part in step.split('|')" :key="part">{{ part }}</span></div>
								</div>
							</div>
							<div class="summary">
								<h3>? <span>Sintesi provvisoria della tua riflessione</span></h3>
								<p>Hai osservato pi? segnali (isolamento, assenze) e formulato un'ipotesi di disagio,
									considerando anche l'ipotesi alternativa di un cambiamento fisiologico. Stai
									ampliando la raccolta di elementi per confronto.</p>
							</div>
							<div class="overview">
								<h3>? <span>A colpo d'occhio</span></h3>
								<p><b class="check">?</b><strong>Dimensioni esplorate:
										3</strong><br><small>(osservazione, organizzazione, ipotesi)</small></p>
								<p><b class="empty"> </b><strong>Da approfondire: 2</strong><br><small>(condivisione,
										rete)</small></p>
								<p><b class="question">?</b><strong>Domanda ancora aperta</strong><br><small>Quali
										ulteriori evidenze, scolastiche o relazionali,<br> possono aiutarti a
										discriminare tra le ipotesi?</small></p>
							</div>
						</div>
				</section>
			</template>
			<slot v-else />
		</main>
	</div>
</template>

<style>
